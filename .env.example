# Copia este archivo como .env y reemplaza estos ejemplos localmente.
# No guardes .env ni contraseñas en el repositorio.
EMAPA_HOST=0.0.0.0
EMAPA_PORT=8000
EMAPA_ADMIN_USERNAME=
EMAPA_ADMIN_PASSWORD=
EMAPA_WAREHOUSE_USERNAME=
EMAPA_WAREHOUSE_PASSWORD=
EMAPA_WAREHOUSE_2_USERNAME=
EMAPA_WAREHOUSE_2_PASSWORD=
EMAPA_WAREHOUSE_3_USERNAME=
EMAPA_WAREHOUSE_3_PASSWORD=
EMAPA_WAREHOUSE_4_USERNAME=
EMAPA_WAREHOUSE_4_PASSWORD=
EMAPA_WAREHOUSE_5_USERNAME=
EMAPA_WAREHOUSE_5_PASSWORD=
EMAPA_AUDITOR_USERNAME=
EMAPA_AUDITOR_PASSWORD=
# En Render, PORT es dinámico. Para producción, Render debe usar HTTPS.
# EMAPA_CORS_ORIGINS=https://tu-sitio.netlify.app
EMAPA_BEHIND_HTTPS=0
EMAPA_COOKIE_SECURE=0
EMAPA_CROSS_SITE_COOKIES=0
# Opcional: ruta fuera del repositorio para la base de datos.
# EMAPA_DB_PATH=
